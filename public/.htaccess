# ==============================================================================
# 🦅 GRABTHEBYTE: HOSTINGER PRODUCTION .HTACCESS
# ==============================================================================

# Enable Rewrite Engine
RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove trailing slashes
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# Handle SPA routing - serve index.html for all routes
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Enable Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ==============================================================================
# 🛡️ TITANIUM FORCEFIELD: SECURITY HEADERS
# ==============================================================================
<IfModule mod_headers.c>
    # Prevents MIME-sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Prevents Clickjacking (Upgraded from SAMEORIGIN to DENY for max security)
    Header set X-Frame-Options "DENY"
    
    # Legacy XSS Protection
    Header set X-XSS-Protection "1; mode=block"
    
    # Protects student privacy on external links
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Forces browsers to always use HTTPS
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Content Security Policy (Upgraded for OneSignal & Sentry VIP Access)
# Content Security Policy (Fully Unlocked for OneSignal API & CDN)
# Content Security Policy (Fully Unlocked for OneSignal API, CDN, & CSS)
    Header set Content-Security-Policy "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.razorpay.com https://onesignal.com https://api.onesignal.com https://cdn.onesignal.com https://*.sentry.io; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://checkout.razorpay.com https://cdn.onesignal.com https://api.onesignal.com blob:; style-src 'self' 'unsafe-inline' https://onesignal.com https://cdn.onesignal.com; frame-src 'self' https://checkout.razorpay.com https://api.razorpay.com; img-src 'self' data: https:; font-src 'self' data: https:;"
        </IfModule>

# Prevent directory listing
Options -Indexes

# Block access to sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>